{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "build:frontends": "pnpm --filter @workspace/TolipAI-website run build && pnpm --filter @workspace/TolipAI-crm run build && pnpm --filter @workspace/TolipAI-tools run build",
    "build:prod": "pnpm run build:frontends && node ./build.mjs",
    "build:prod:with-db": "pnpm --filter @workspace/db run push && pnpm run build:frontends && node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "start:fast": "[ -f dist/index.mjs ] && node --enable-source-maps ./dist/index.mjs || (pnpm run build:prod && node --enable-source-maps ./dist/index.mjs)",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:demo": "tsx src/seed-demo.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^1.25.0",
    "@opentelemetry/instrumentation": "^0.52.0",
    "@opentelemetry/sdk-trace-base": "^1.25.0",
    "@opentelemetry/semantic-conventions": "^1.25.0",
    "@sentry/node": "^10.53.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/papaparse": "^5.5.2",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.3",
    "papaparse": "^5.5.3",
    "pino": "^9",
    "pino-http": "^10",
    "stripe": "^22.0.0",
    "twilio": "^5.0.0",
    "ws": "^8.20.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/nodemailer": "^7.0.11",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
