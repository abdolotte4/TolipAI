# after editing this file.
#
# Compatibility contract — verified against crawl4ai==0.8.9 (PyPI requires_dist):
#   crawl4ai==0.8.9 requires:
#     lxml~=5.3            — still requires lxml 5.x (<6); do NOT upgrade lxml to 6.x
#     pillow>=10.4         — no upper bound; Pillow 12.x is fine
#     beautifulsoup4~=4.12 — >=4.12,<5; 4.14.x is within range ✅
#     pydantic>=2.10       — ✅ satisfied
#     playwright>=1.49.0   — ✅ satisfied
#     playwright-stealth>=2.0.0 — ✅ satisfied
#     aiohttp>=3.11.11     — ✅ satisfied
#     httpx>=0.27.2        — ✅ satisfied
#     psutil>=6.1.1        — do NOT pin psutil < 6.1.1

