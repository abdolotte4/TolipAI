# after editing this file.
#
# Compatibility contract — do NOT relax these bounds without checking crawl4ai:
#   crawl4ai==0.6.3 requires:
#     psutil>=6.1.1        — do NOT pin psutil < 6.1.1
#     lxml~=5.3            — do NOT upgrade lxml to 6.x
#     pillow~=10.4         — must stay >=10.4,<11
#     pydantic>=2.10       — ✅ satisfied
#     playwright>=1.49.0   — ✅ satisfied
#     aiohttp>=3.11.11     — ✅ satisfied
#     httpx>=0.27.2        — ✅ satisfied

