{
  "family": "tolipai-scraper-engine",
  "taskRoleArn": "arn:aws:iam::583299526161:role/tolipai-scraper-task-role",
  "executionRoleArn": "arn:aws:iam::583299526161:role/TolipAI-scraper-execution-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "2048",
  "memory": "4096",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "ARM64"
  },
  "containerDefinitions": [
    {
      "name": "scraper",
      "image": "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/tolipai-scraper:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8765,
          "hostPort": 8765,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "8765"
        },
        {
          "name": "LOG_LEVEL",
          "value": "info"
        },
        {
          "name": "BROWSER_MAX_CONCURRENT",
          "value": "3"
        },
        {
          "name": "SPOT_EXIT_DEADLINE_SECONDS",
          "value": "90"
        },
        {
          "name": "CIRCUIT_FAILURE_THRESHOLD",
          "value": "5"
        },
        {
          "name": "CIRCUIT_RECOVERY_TIMEOUT",
          "value": "120"
        },
        {
          "name": "CACHE_DEFAULT_TTL",
          "value": "3600"
        },
        {
          "name": "CACHE_REDIS_TTL",
          "value": "86400"
        },
        {
          "name": "SCRAPER_TIMEOUT",
          "value": "45"
        },
        {
          "name": "SCRAPER_JOB_CONCURRENCY",
          "value": "4"
        },
        {
          "name": "BRIGHTDATA_PORT",
          "value": "33335"
        },
        {
          "name": "ENABLE_GOOGLE_DORKS",
          "value": "false"
        },
        {
          "name": "ENABLE_OPENCORPORATES",
          "value": "true"
        },
        {
          "name": "ENABLE_PROPERTYAPI",
          "value": "true"
        },
        {
          "name": "S3_CACHE_BUCKET",
          "value": ""
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/database-url"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/redis-url"
        },
        {
          "name": "SCRAPER_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/api-key"
        },
        {
          "name": "OPENROUTER_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/openrouter-key"
        },
        {
          "name": "GROQ_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/groq-key"
        },
        {
          "name": "MOONSHOT_KIMI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/moonshot-key"
        },
        {
          "name": "NVIDIA_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/nvidia-key"
        },
        {
          "name": "CEREBRAS_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/cerebras-key"
        },
        {
          "name": "ATTOM_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/attom-key"
        },
        {
          "name": "ATTOM_API_KEY_2",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/attom-key-2"
        },
        {
          "name": "BRIGHTDATA_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/brightdata-username"
        },
        {
          "name": "BRIGHTDATA_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/brightdata-password"
        },
        {
          "name": "BRIGHTDATA_API",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/brightdata-api"
        },
        {
          "name": "OXYLABS_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/oxylabs-username"
        },
        {
          "name": "OXYLABS_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/oxylabs-password"
        },
        {
          "name": "PROPELIO_EMAIL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/propelio-email"
        },
        {
          "name": "PROPELIO_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/propelio-password"
        },
        {
          "name": "PROPWIRE_EMAIL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/propwire-email"
        },
        {
          "name": "PROPWIRE_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/propwire-password"
        },
        {
          "name": "GOOGLE_MAPS_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/google-maps-key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tolipai-scraper",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "scraper",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -sf http://localhost:8765/health || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 60
      },
      "stopTimeout": 90,
      "linuxParameters": {
        "initProcessEnabled": true
      },
      "ulimits": [
        {
          "name": "nofile",
          "softLimit": 65536,
          "hardLimit": 65536
        }
      ]
    }
  ]
}
