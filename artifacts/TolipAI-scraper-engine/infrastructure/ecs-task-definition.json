{
  "family": "tolipai-scraper-engine",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "8192",
  "executionRoleArn": "arn:aws:iam::583299526161:role/TolipAI-scraper-execution-role",
  "taskRoleArn": "arn:aws:iam::583299526161:role/tolipai-scraper-task-role",
  "containerDefinitions": [
    {
      "name": "scraper",
      "image": "583299526161.dkr.ecr.us-east-1.amazonaws.com/tolipai-scraper:latest",
      "portMappings": [
        {
          "containerPort": 8765,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        { "name": "PORT", "value": "8765" },
        { "name": "HOST", "value": "0.0.0.0" },
        { "name": "PYTHON_ENV", "value": "production" },
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "SCRAPER_TIMEOUT", "value": "55" },
        { "name": "SCRAPER_JOB_CONCURRENCY", "value": "5" },
        { "name": "MAX_CONCURRENT_TASKS", "value": "15" },
        { "name": "MAX_BROWSERS_PER_JOB", "value": "3" },
        { "name": "DISTRESSED_COMP_CHECK", "value": "true" },
        { "name": "CASH_BUYER_MIN_OFFER", "value": "0.7" },
        { "name": "CASH_BUYER_MAX_OFFER", "value": "0.85" },
        { "name": "SKIP_ARV_ESTIMATE", "value": "false" },
        { "name": "LEAD_TIMEOUT", "value": "1800" },
        { "name": "RETRY_COUNT", "value": "3" },
        { "name": "RATE_LIMIT_MS", "value": "1000" },
        { "name": "CACHE_TTL_HOURS", "value": "24" },
        { "name": "HEALTH_CHECK_PORT", "value": "8765" },
        { "name": "HEALTH_CHECK_PATH", "value": "/health" },
        { "name": "HEALTH_CHECK_INTERVAL", "value": "30" },
        { "name": "HEALTH_CHECK_TIMEOUT", "value": "5" },
        { "name": "HEALTH_CHECK_UNHEALTHY_THRESHOLD", "value": "2" },
        { "name": "HEALTH_CHECK_HEALTHY_THRESHOLD", "value": "2" },
        { "name": "ENABLE_METRICS", "value": "true" },
        { "name": "METRICS_PORT", "value": "9090" },
        { "name": "SCRAPER_ENGINE_VERSION", "value": "2.0.0" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/database-url-gam8ov" },
        { "name": "SCRAPER_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/webscraper-key-j2BZWg" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/jwt-secret-wOQull" },
        { "name": "OPENAI_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/openai-api-key-KcZLh9" },
        { "name": "BRIGHTDATA_USERNAME", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/brightdata-username-IiufoR" },
        { "name": "BRIGHTDATA_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/brightdata-password-bac7WH" },
        { "name": "OXYLABS_USERNAME", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/oxylabs-username-QHmB6v" },
        { "name": "OXYLABS_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/oxylabs-password-CIvu5s" },
        { "name": "PROPELIO_EMAIL", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/propelio-email-0JAHk4" },
        { "name": "PROPELIO_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/propelio-password-SShGWO" },
        { "name": "PROPWIRE_EMAIL", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/propwire-email-dieuRL" },
        { "name": "PROPWIRE_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/propwire-password-vA52VR" },
        { "name": "GOOGLE_MAPS_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/google-maps-key-89upPY" },
        { "name": "REDIS_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/redis-url-CSzF81" },
        { "name": "S3_CACHE_BUCKET", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/s3-cache-bucket-rIXWv4" },
        { "name": "ADMIN_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/ADMIN_API_KEY" },
        { "name": "REALFORECLOSE_USERNAME", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/REALFORECLOSE_USERNAME" },
        { "name": "REALFORECLOSE_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:583299526161:secret:TolipAI/scraper/REALFORECLOSE_PASSWORD" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tolipai-scraper-engine",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8765/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "ulimits": [
        {
          "name": "nofile",
          "softLimit": 65536,
          "hardLimit": 65536
        }
      ]
    }
  ]
}
