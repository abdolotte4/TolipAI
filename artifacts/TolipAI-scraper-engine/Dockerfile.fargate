# ── TolipAI Scraper Engine — AWS Fargate Spot Dockerfile ─────────────────────
#
# Optimised for:
#  • ARM64 (Graviton3) — 20% cheaper than x86 on Fargate Spot
#  • Multi-stage build — small final image (no pip cache, no build deps)
#  • Fargate Spot interruption handling via spot_handler.py
#  • ECS health checks via /health endpoint
#  • pip-compile lockfile — deterministic installs, conflicts caught at build time
#
# Build:
#   docker build -f Dockerfile.fargate --platform linux/arm64 -t TolipAI-scraper:latest .
#
# Regenerate lockfile (run locally, then commit requirements.lock):
#   ./infrastructure/update-lockfile.sh

FROM python:3.11-slim-bookworm AS builder

WORKDIR /build

# System build deps only — not included in final image
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    libffi-dev \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps into a venv so the final stage can just copy /venv
RUN python -m venv /venv
ENV PATH="/venv/bin:$PATH"

# ── Dependency installation with pip-compile lockfile ─────────────────────────
# requirements.in  = direct deps with intentional version constraints (editable)
# requirements.lock = fully-resolved lockfile (all transitive deps pinned)
#
# Workflow:
#  1. If requirements.lock is committed, install from it (fast + deterministic).
#  2. If requirements.lock is missing, pip-compile generates it on the fly and
#     installs from the result — this also catches any resolution conflicts so
#     the build fails here rather than at ECS startup.
#  3. A separate CI job (validate-lockfile) checks that requirements.lock is in
#     sync with requirements.in so stale lockfiles are caught before merge.
COPY requirements.in ./
COPY requirements.lock* ./

RUN pip install --no-cache-dir --upgrade pip pip-tools && \
    if [ -f requirements.lock ]; then \
        echo "==> Installing from committed requirements.lock …"; \
        pip install --no-cache-dir -r requirements.lock; \
    else \
        echo "==> requirements.lock not found — generating from requirements.in …"; \
        pip-compile requirements.in \
            --output-file requirements.lock \
            --no-header \
            --quiet \
            --resolver backtracking && \
        pip install --no-cache-dir -r requirements.lock; \
    fi

# Install Playwright Chromium browser binary into /app/.cache so the non-root
# scraper user can read it in the final stage (browsers in /root/.cache would
# be inaccessible to non-root users).
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.cache/ms-playwright
RUN playwright install chromium --with-deps 2>/dev/null || \
    playwright install chromium 2>/dev/null || true


# ── Final image ───────────────────────────────────────────────────────────────
FROM python:3.11-slim-bookworm

LABEL org.opencontainers.image.title="TolipAI-scraper-engine"
LABEL org.opencontainers.image.description="TolipAI scraper engine — AWS Fargate Spot"
LABEL org.opencontainers.image.source="https://github.com/Agawish24/TolipAI"

WORKDIR /app

# Runtime system deps for Playwright Chromium on ARM64
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Playwright / Chromium
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    libexpat1 \
    libxkbcommon0 \
    libx11-6 \
    libxcomposite1 \
    libxext6 \
    libxcb1 \
    # OCR + PDF
    tesseract-ocr \
    poppler-utils \
    libgomp1 \
    libgl1 \
    libglib2.0-0 \
    libpq5 \
    # Misc
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy Python env from builder
COPY --from=builder /venv /venv
# Browser cache already lives under /app/.cache in the builder — copy it here
# so it stays under /app and is chowned to the scraper user below.
COPY --from=builder /app/.cache /app/.cache

ENV PATH="/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.cache/ms-playwright

# ── App code ──────────────────────────────────────────────────────────────────
COPY workers/ ./workers/
COPY start.fargate.sh ./start.sh
RUN chmod +x ./start.sh

# Fargate health check — ECS pings /health every 30s
HEALTHCHECK \
    --interval=30s \
    --timeout=10s \
    --start-period=60s \
    --retries=3 \
    CMD curl -sf http://localhost:${PORT:-8765}/health || exit 1

EXPOSE 8765

# Run as non-root user for security
RUN useradd -r -s /bin/false scraper && \
    chown -R scraper:scraper /app
USER scraper

CMD ["bash", "./start.sh"]
