# ── TolipAI Scraper Engine — Fast Deploy Dockerfile ──────────────────────────
# Uses a pre-built base image (tolipai-scraper-base) that already contains:
#   - Python 3.13 venv with all dependencies
#   - Playwright Chromium browser binaries
#
# The base image is built once and reused. This Dockerfile only:
#   1. Pulls the base image
#   2. Copies the latest app code
#   3. Sets up the entrypoint
#
# Build time: ~2-3 minutes (vs 10-15 minutes with full QEMU build)
#
# To build the base image (run once or weekly):
#   docker build -f Dockerfile.base --platform linux/arm64 -t BASE .
#   docker tag BASE ECR_REGISTRY/tolipai-scraper-base:latest
#   docker push ECR_REGISTRY/tolipai-scraper-base:latest
# ──────────────────────────────────────────────────────────────────────────────

ARG BASE_IMAGE=583299526161.dkr.ecr.us-east-1.amazonaws.com/tolipai-scraper-base:latest

FROM ${BASE_IMAGE} AS app

WORKDIR /app

# Install any packages added since the base image was last built.
# This runs as root before USER scraper so it can write to /venv.
# Fast (no-op) if base is up-to-date; catches new deps without a base rebuild.
COPY requirements.txt ./
RUN /venv/bin/pip install --no-cache-dir -q -r requirements.txt 2>&1 | tail -5

# Copy only the app code (the heavy deps are in the base image)
COPY --chown=scraper:scraper workers/ ./workers/
COPY --chown=scraper:scraper start.fargate.sh ./start.sh
RUN chmod +x ./start.sh

# Fargate health check
HEALTHCHECK \
    --interval=30s \
    --timeout=10s \
    --start-period=60s \
    --retries=3 \
    CMD curl -sf http://localhost:${PORT:-8765}/health || exit 1

EXPOSE 8765

USER scraper

CMD ["bash", "./start.sh"]
