FROM public.ecr.aws/lambda/python:3.11

# ── System deps for Playwright Chromium ──────────────────────────────────────
RUN dnf install -y --setopt=install_weak_deps=False \
    atk \
    at-spi2-atk \
    cups-libs \
    libdrm \
    libXcomposite \
    libXdamage \
    libXfixes \
    libXrandr \
    mesa-libgbm \
    pango \
    cairo \
    alsa-lib \
    nss \
    nspr \
    libxkbcommon \
    libX11 \
    libXext \
    libXcb \
    expat \
    # tesseract + poppler for PDF scraping
    tesseract \
    poppler-utils \
    # OpenGL for YOLO (ultralytics)
    mesa-libGL \
    mesa-libGLU \
    && dnf clean all

# ── Python deps ───────────────────────────────────────────────────────────────
COPY requirements.railway.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        # Lambda Runtime Interface Client
        awslambdaric \
        # AWS SDK
        boto3 \
        # asyncpg for RDS/Aurora
        asyncpg \
    && pip install --no-cache-dir -r requirements.railway.txt

# ── Playwright Chromium ───────────────────────────────────────────────────────
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN python -m playwright install chromium --with-deps 2>/dev/null || \
    python -m playwright install chromium

# ── Pre-fetch YOLO weights into image layer ───────────────────────────────────
RUN python -c "from ultralytics import YOLO; YOLO('yolov8n.pt')" 2>/dev/null || true

# ── Application code ──────────────────────────────────────────────────────────
COPY workers/ ${LAMBDA_TASK_ROOT}/workers/

# ── Lambda-specific environment ───────────────────────────────────────────────
# /tmp is the only writable directory in Lambda — store browser sessions there
ENV BROWSER_STATE_DIR=/tmp
# Lambda has no display; Playwright uses headless Chromium automatically
ENV DISPLAY=
# Playwright needs a writable home for its config
ENV HOME=/tmp

# ── Entry point ───────────────────────────────────────────────────────────────
# workers/lambda_handler.handler is the universal router.
# Override with a specific handler per Lambda function for tighter IAM scoping:
#   e.g.  workers.lambda_handler.health_handler
#         workers.lambda_handler.distressed_handler
CMD ["workers.lambda_handler.handler"]
