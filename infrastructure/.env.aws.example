## infrastructure/.env.aws.example
##
## Copy to infrastructure/.env.aws and fill in your values.
## This file is sourced by deploy.sh, ecr-push.sh, and scaling.sh.
## Never commit .env.aws — it is gitignored.

# ── Required ──────────────────────────────────────────────────────────────────
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# ── Optional overrides (defaults shown) ───────────────────────────────────────
ECR_REPO_NAME=TolipAI-scraper
ECS_CLUSTER=TolipAI-scraper-cluster
ECS_SERVICE=TolipAI-scraper-engine
TASK_DEFINITION=TolipAI-scraper-engine

# ── Image tag (defaults to current git SHA) ───────────────────────────────────
# IMAGE_TAG=v1.2.3

# ── Scaling bounds (used by scaling.sh) ───────────────────────────────────────
# MIN_CAPACITY=1
# MAX_CAPACITY=10
# BUSINESS_MIN=2
# BUSINESS_MAX=8
# NIGHT_MIN=1

# ── S3 cache bucket (used by s3-setup.sh) ─────────────────────────────────────
# S3_BUCKET=TolipAI-scraper-storage
