{
  "family": "digor-scraper-engine",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/digor-scraper-task-role",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/digor-scraper-execution-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "ARM64"
  },
  "containerDefinitions": [
    {
      "name": "scraper",
      "image": "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/digor-scraper:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8765,
          "hostPort": 8765,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT",                     "value": "8765" },
        { "name": "LOG_LEVEL",                "value": "info" },
        { "name": "BROWSER_MAX_CONCURRENT",   "value": "3" },
        { "name": "SPOT_EXIT_DEADLINE_SECONDS","value": "90" },
        { "name": "CIRCUIT_FAILURE_THRESHOLD","value": "5" },
        { "name": "CIRCUIT_RECOVERY_TIMEOUT", "value": "120" },
        { "name": "CACHE_DEFAULT_TTL",        "value": "3600" },
        { "name": "CACHE_REDIS_TTL",          "value": "86400" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:digor/scraper/database-url"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:digor/scraper/redis-url"
        },
        {
          "name": "SCRAPER_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:digor/scraper/api-key"
        },
        {
          "name": "OPENROUTER_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:digor/scraper/openrouter-key"
        },
        {
          "name": "GROQ_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:digor/scraper/groq-key"
        },
        {
          "name": "ATTOM_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:digor/scraper/attom-key"
        },
        {
          "name": "BRIGHTDATA_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:digor/scraper/brightdata-username"
        },
        {
          "name": "BRIGHTDATA_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:digor/scraper/brightdata-password"
        },
        {
          "name": "PROPELIO_EMAIL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:digor/scraper/propelio-email"
        },
        {
          "name": "PROPELIO_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:digor/scraper/propelio-password"
        },
        {
          "name": "PROPWIRE_EMAIL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:digor/scraper/propwire-email"
        },
        {
          "name": "PROPWIRE_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:digor/scraper/propwire-password"
        },
        {
          "name": "S3_CACHE_BUCKET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:digor/scraper/s3-cache-bucket"
        },
        {
          "name": "TWILIO_ACCOUNT_SID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:digor/scraper/twilio-account-sid"
        },
        {
          "name": "TWILIO_AUTH_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:digor/scraper/twilio-auth-token"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/digor-scraper",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "scraper",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -sf http://localhost:8765/health || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 60
      },
      "stopTimeout": 90,
      "linuxParameters": {
        "initProcessEnabled": true
      },
      "ulimits": [
        {
          "name": "nofile",
          "softLimit": 65536,
          "hardLimit": 65536
        }
      ]
    }
  ]
}
