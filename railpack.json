{
  "$schema": "https://railpack.com",
  "provider": "node",
  "packages": {
    "node": "20",
    "pnpm": "9.15.9"
  },
  "steps": {
    "install": {
      "inputs": ["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "**/package.json"],
      "commands": ["pnpm install --no-frozen-lockfile"]
    },
    "build": {
      "inputs": ["."],
      "commands": ["pnpm --filter @workspace/api-server run build:prod"]
    }
  }
}
