{
  "$schema": "https://railpack.com",
  "provider": "node",
  "packages": {
    "node": "20",
    "pnpm": "9.15.9"
  },
  "steps": {
    "install": {
      "commands": ["pnpm install --no-frozen-lockfile"]
    },
    "build": {
      "inputs": ["."],
      "commands": ["pnpm --filter @workspace/api-server run build:prod"]
    }
  },
  "deploy": {
    "startCommand": "node --enable-source-maps artifacts/api-server/dist/index.mjs"
  }
}
