# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Platform files (not for public repo)
.cache/
.local/
.replit
replit.md
.replit-artifact/
.replitignore

# Monorepo and Build artifacts
artifacts/**/dist/
artifacts/**/.vite/
artifacts/**/.next/
lib/**/dist/

# Database dump files — large binary/SQL files not for version control
merged.sql
merged_neondb.zip
schema.sql
backup.sql
backup.sql~
*.dump
*.sql.gz

# Environment Secrets
.env
.env.local

# Attached assets (uploaded files, screenshots, etc.)
attached_assets/

# Exclude Replit Agent sandbox
artifacts/mockup-sandbox/

# Aider — keep config/scripts tracked, exclude only runtime cache/history
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v4/

# Deployment configs — root level only (scraper engine has its own Dockerfile)
/Dockerfile
/Procfile
nixpacks.toml

# Local dev / env
.python-version
.replit*
.dockerignore
uv.lock

# Runtime / cache
__pycache__/
*.pyc
node_modules/
dist/
tmp/
out-tsc/
*.tsbuildinfo
push_github.sh
merged.sql
