# ==============================================================================
# Digor CRM & Tools — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your .env file — it is listed in .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/digor

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string

# Super admin account (seeded on first startup)
CRM_ADMIN_EMAIL=admin@yourdomain.com
CRM_ADMIN_PASSWORD=replace-with-secure-password

# Tools portal PIN (numeric, 4–8 digits recommended)
TOOLS_PIN=0000

# ------------------------------------------------------------------------------
# Advanced Scraper Engine (Python — digor-scraper-engine)
# ------------------------------------------------------------------------------
# URL of the Python FastAPI engine. Local dev: http://localhost:8765
# Railway prod: http://digor-scraper-engine.railway.internal:8765
SCRAPER_ENGINE_URL=http://localhost:8000

# Kimi K2 — primary via NVIDIA, fallback via Moonshot
NVIDIA_API_KEY=nvapi-...
MOONSHOT_KIMI_API_KEY=sk-...
# Optional overrides
# NVIDIA_KIMI_MODEL=moonshotai/kimi-k2-instruct
# MOONSHOT_MODEL=kimi-k2-0905-preview

# ScraperAPI (auto-CAPTCHA, rendered JS) — supports up to 4 keys
SCRAPERAPI_KEY=your-scraperapi-key
SCRAPERAPI_KEY_2=
SCRAPERAPI_KEY_3=
SCRAPERAPI_KEY_4=

# ScrapingBee (alternate auto-CAPTCHA provider)
SCRAPINGBEE_API_KEY=
WEBSCRAPER_API_KEY=

# Residential proxy (Oxylabs / BrightData / generic)
PROXY_HOST=
PROXY_USER=
PROXY_PASS=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
BRIGHTDATA_API=

# ------------------------------------------------------------------------------
# AI / LLM
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_...
# Optional: override the default model
# AI_MODEL=llama-3.1-70b-versatile

# ------------------------------------------------------------------------------
# Property Data & Valuations
# ------------------------------------------------------------------------------
# ATTOM Data Solutions
ATTOM_API_KEY=your-attom-primary-key
ATTOM_API_KEY_2=your-attom-secondary-key   # optional — enables automatic rotation

# PropertyAPI.co (supports up to 7 keys in round-robin rotation)
PROPERTY_API_KEY=your-propertyapi-key       # legacy single-key (still supported)
PROPERTY_API_KEY_1=your-propertyapi-key-1
PROPERTY_API_KEY_2=your-propertyapi-key-2
PROPERTY_API_KEY_3=your-propertyapi-key-3
PROPERTY_API_KEY_4=your-propertyapi-key-4  # optional
PROPERTY_API_KEY_5=your-propertyapi-key-5  # optional
PROPERTY_API_KEY_6=your-propertyapi-key-6  # optional
PROPERTY_API_KEY_7=your-propertyapi-key-7  # optional

# Rentcast (optional — enables rental/sale AVM in CRM)
RENTCAST_API_KEY=your-rentcast-key

# ------------------------------------------------------------------------------
# Communications
# ------------------------------------------------------------------------------
# SignalWire (optional — enables VoIP call/SMS logging)
SIGNALWIRE_PROJECT_ID=your-signalwire-project-id
SIGNALWIRE_API_TOKEN=your-signalwire-api-token
SIGNALWIRE_SPACE_URL=your-space.signalwire.com

# OpenPhone (optional — alternative telephony provider)
OPENPHONE_API_KEY=your-openphone-key

# SMTP (optional — required for automated email sequences)
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-smtp-password

# ------------------------------------------------------------------------------
# Payments
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# Authenticated scrapers (Propelio + Propwire)
# ------------------------------------------------------------------------------
# Propelio (https://genesis.propelio.com) — comps + cash-buyer panel
PROPELIO_EMAIL=you@example.com
PROPELIO_PASSWORD=your-propelio-password

# Propwire (https://propwire.com) — property details, comps, history, nearby buyers
PROPWIRE_EMAIL=you@example.com
PROPWIRE_PASSWORD=your-propwire-password

# Scraper engine URL (used by Node API to talk to the Python FastAPI service)
# Leave empty in single-service deploys to default to http://localhost:8765
SCRAPER_ENGINE_URL=https://your-scraper-engine.up.railway.app
